# Zorq environment contract — PLACEHOLDERS ONLY.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Server-only secrets must never appear in frontend source, browser bundles,
# Git, logs, screenshots, README, or committed MCP configuration.

# --- Qloo (official hackathon transport) ---
QLOO_API_KEY=
# Optional overrides. Both must equal https://hackathon.api.qloo.com for MCP transport;
# any other origin is rejected lazily when the gateway is first used (never at boot).
QLOO_BASE_URL=
QLOO_TRUSTED_BASE_URL=

# --- DeepSeek (locked LLM provider, OpenAI-compatible) ---
DEEPSEEK_API_KEY=

# --- Persistence (Turso/libSQL free tier) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Runtime ---
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# --- Budgets and bounds (locked; tune only from measured integration evidence) ---
LLM_BUDGET_USD=2.00
MAX_QLOO_CALLS=180
QLOO_CONCURRENCY=6
QLOO_CACHE_TTL_SEC=21600
PERSIST_QLOO_DERIVED=false

# --- Frontend-visible (non-secret) map configuration ---
# MapLibre GL JS + MapTiler Free. Safe to expose to the browser.
VITE_MAPTILER_KEY=
